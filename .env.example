# =============================================================================
# DataGusto Platform - deployment configuration (images from Amazon ECR)
# Copy to .env and fill in the REQUIRED values. Everything else is optional.
# =============================================================================

# ---- REQUIRED ---------------------------------------------------------------

# Image tag to run. Use the same version as this repository's tag.
DATAGUSTO_VERSION=0.1.0

# URL users type in the browser, without trailing slash.
# http://<host> for the default HTTP setup, https://<host> with compose.tls.yml.
PUBLIC_BASE_URL=http://datagusto.example.local

# Database password for the bundled PostgreSQL (or the external server).
POSTGRES_PASSWORD=

# Token signing keys. Generate each with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_REFRESH_SECRET_KEY=

# ---- OPTIONAL: network ------------------------------------------------------

# Host port the proxy listens on.
#HTTP_PORT=80
#HTTPS_PORT=443

# Registry the images are pulled from, with trailing slash: the registry host
# you received from datagusto, or your own registry if you mirror the images.
IMAGE_REGISTRY=

# ---- OPTIONAL: database (compose.external-db.yml) --------------------------
#POSTGRES_HOST=postgres
#POSTGRES_PORT=5432
#POSTGRES_DB=datagusto
#POSTGRES_USER=datagusto

# ---- OPTIONAL: application --------------------------------------------------

# Allow password sign-up. Set to true only while creating the first account.
#ENABLE_REGISTRATION=false

# Number of API worker processes.
#UVICORN_WORKERS=2

#JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
#JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Master switch for Slack / e-mail notifications configured in the UI.
#NOTIFICATIONS_ENABLED=true
#SUSPECTED_VALIDATION_SWEEP_INTERVAL_SECONDS=600

# License public key (PEM) to override the bundled one. Normally unset.
#LICENSE_PUBLIC_KEY=

# ---- OPTIONAL: LLM provider -------------------------------------------------
# Required only for LLM-backed features. Supported: openai, azure_openai,
# anthropic, ollama, vllm. Endpoints inside your network work as long as the
# backend container can reach them.
#LLM_PROVIDER=
#LLM_MODEL=
#LLM_API_KEY=
#LLM_ENDPOINT=
#LLM_API_VERSION=
#LLM_MAX_TOKENS=32000
#LLM_JUDGE_MODEL=
#LLM_JUDGE_MAX_TOKENS=128
#LLM_PROXY_HEADER_AUTHORIZATION=
#LLM_PROXY_HEADER_SYSTEM_CODE=
#LLM_VLLM_ENABLE_THINKING=false
#LLM_VLLM_REASONING_EFFORT=
#LLM_VLLM_STRUCTURED_OUTPUT_THINKING=false
#LLM_VLLM_REQUEST_TIMEOUT_SECONDS=1200
#LLM_OLLAMA_NUM_CTX=32768
#LLM_OLLAMA_THINKING=
#LLM_OLLAMA_REQUEST_TIMEOUT_SECONDS=1200

# ---- OPTIONAL: outbound proxy and private CA --------------------------------
# Only used by optional integrations (LLM, Slack, SMTP, Azure DevOps, GitHub).
#HTTP_PROXY=
#HTTPS_PROXY=
# Internal hosts are excluded by default; add your own entries to this list.
#NO_PROXY=localhost,127.0.0.1,postgres,frontend,backend
# Private CA: put a COMPLETE bundle (public CAs plus your CA) in ./ca/ca.pem
# and point to it inside the container. The file replaces the system bundle.
#SSL_CERT_FILE=/etc/datagusto/ca/ca.pem
